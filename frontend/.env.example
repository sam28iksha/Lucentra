# ─── API ─────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─── AG Studio license key (optional, passed to AgStudioProvider) ────────────
# Keep this blank during dev; AG Studio shows a watermark in prod without it.
VITE_AG_STUDIO_LICENSE_KEY=

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "true" to show the Sandbox tools panel in the UI
VITE_SANDBOX_MODE=true

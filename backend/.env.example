# ─── PayPal Sandbox (Required for live PayPal sync) ──────────────────────────
# Retrieve from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# ─── Database ────────────────────────────────────────────────────────────────
# Use the Neon DIRECT (non-pooled) connection string — port 5432, not 6543.
# The asyncpg driver is incompatible with Neon's PgBouncer pooler (port 6543)
# because PgBouncer runs in transaction-pooling mode, which breaks prepared
# statements and session state that asyncpg relies on.
# Find this string in Neon dashboard → Project → Connection string → Direct.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/DBNAME?ssl=require

# ─── AI Provider (Required for AI dispute evidence pack generation) ─────────
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022
AI_API_KEY=your_anthropic_api_key_here

# ─── AG Studio (Optional — omit to use AG Grid community) ─────────────────────
AG_STUDIO_LICENSE_KEY=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=lucentra_dev_jwt_secret_key_32_bytes_min_super_secure!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── App Configuration ───────────────────────────────────────────────────────
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ─── Sandbox Mode (set to "true" to expose sandbox simulation tools) ─────────
SANDBOX_MODE=true

# ─── PayPal Sandbox (required) ────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# ─── Database (required) ──────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://lucentra:lucentra@localhost:5432/lucentra

# ─── AI Provider (required for AI features) ───────────────────────────────────
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022
AI_API_KEY=your_anthropic_key_here

# ─── AG Studio (optional — omit to use AG Grid community) ────────────────────
AG_STUDIO_LICENSE_KEY=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_generate_a_real_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ─── Sandbox mode (set to "true" to expose sandbox-only tools) ───────────────
SANDBOX_MODE=true
